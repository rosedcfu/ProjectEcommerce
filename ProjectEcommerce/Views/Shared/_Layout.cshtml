@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Haneul</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectEcommerce.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            @if (SignInManager.IsSignedIn( User ))
            {
                var user = await UserManager.GetUserAsync( User );
                var roles = await UserManager.GetRolesAsync( user );

                if (roles.Contains( "Admin" ))
                {
                    <button class="btn btn-primary" type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#adminSidebar"
                            aria-controls="adminSidebar">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="container-fluid">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">HANEUL</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Order" asp-action="AllOrders">Panel Admin</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Products" asp-action="Index">Administrar Productos</a>
                                </li>
                        </div>
                    </div>

                }
            }
            @if (!SignInManager.IsSignedIn( User ) || (await UserManager.GetRolesAsync( await UserManager.GetUserAsync( User ) )).Contains( "Customer" ))
            {
                <button class="btn btn-primary" type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#customerSidebar"
                        aria-controls="customerSidebar">
                    <i class="bi bi-list"></i>
                </button>
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">HANEUL</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                   
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Store" asp-action="Index">Store</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Cart" asp-action="Index">🛒 Carrito</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Order" asp-action="MyOrders">Mis Pedidos</a>
                        </li>
                           
                    </div>
                </div>
            }
            <div class="d-flex justify-content-end align-items-center me-3">
                <partial name="_LoginPartial" />
            </div>

        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main" class="pb-3 mb-5">
            @RenderBody()
        </main>
    </div>
    <!-- Sidebar para Admin -->
    <div class="offcanvas offcanvas-start text-bg-dark"
         tabindex="-1"
         id="adminSidebar"
         aria-labelledby="adminSidebarLabel"
         style="width: 260px;">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title" id="adminSidebarLabel">
                <i class="bi bi-lightning-charge-fill text-warning me-2"></i> CPanel
            </h5>
            <button type="button" class="btn-close btn-close-black"
                    data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body px-0 pt-3">
            <nav class="nav flex-column">
                <a class="nav-link text-black px-4 py-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
                <a class="nav-link text-black px-4 py-2" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-box-seam me-2"></i> Productos
                </a>
                <a class="nav-link text-black px-4 py-2" asp-controller="Order" asp-action="AllOrders">
                    <i class="bi bi-receipt me-2"></i> Pedidos
                </a>
                <a class="nav-link text-black px-4 py-2" asp-controller="Cart" asp-action="Index">
                    <i class="bi bi-cart me-2"></i> Carrito
                </a>
                <a class="nav-link text-black px-4 py-2" asp-controller="Home" asp-action="Privacy">
                    <i class="bi bi-shield-lock me-2"></i> Privacidad
                </a>
            </nav>
        </div>
    </div>

    <!-- Sidebar para Customer -->
    <div class="offcanvas offcanvas-start text-bg-dark"
         tabindex="-1"
         id="customerSidebar"
         aria-labelledby="customerSidebarLabel"
         style="width: 260px;">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title" id="customerSidebarLabel">
                <i class="bi bi-person-circle text-info me-2"></i> Haneul Store
            </h5>
            <button type="button" class="btn-close btn-close-black"
                    data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body px-0 pt-3">
            <nav class="nav flex-column">
                <a class="nav-link text-black px-4 py-2" asp-controller="Store" asp-action="Index">
                    <i class="bi bi-shop me-2"></i> Tienda
                </a>
                <a class="nav-link text-black px-4 py-2" asp-controller="Cart" asp-action="Index">
                    <i class="bi bi-cart me-2"></i> Carrito
                </a>
                <a class="nav-link text-black px-4 py-2" asp-controller="Order" asp-action="MyOrders">
                    <i class="bi bi-bag-check me-2"></i> Mis Pedidos
                </a>
                <a class="nav-link text-black px-4 py-2" asp-controller="Home" asp-action="Privacy">
                    <i class="bi bi-shield-lock me-2"></i> Privacidad
                </a>
            </nav>
        </div>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - EcommercePlatform - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <div id="alert-container" class="position-fixed top-0 end-0 p-3" style="z-index: 1055;"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

@if (TempData ["SuccessMessage"] != null)
{
    <span id="temp-success" data-message="@TempData ["SuccessMessage"]"></span>
}
@if (TempData ["ErrorMessage"] != null)
{
    <span id="temp-error" data-message="@TempData ["ErrorMessage"]"></span>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
</html>
