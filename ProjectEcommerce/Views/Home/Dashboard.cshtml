@{
    ViewData ["Title"] = "Panel de Administración";
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 bg-light border-end" style="min-height: 100vh;">
            <div class="py-3">
                <h5><i class="bi bi-speedometer2"></i> Dashboard</h5>
                <hr />
                <h6>Perfil Usuario</h6>
                <ul class="nav flex-column mb-3">
                    <li class="nav-item"><a class="nav-link" href="#">Datos del usuario</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Configuraciones</a></li>
                </ul>
                <h6>Gestión de productos</h6>
                <ul class="nav flex-column mb-3">
                    <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Listado productos</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Ajuste de productos</a></li>
                </ul>
                <h6>Gestión de pedidos</h6>
                <ul class="nav flex-column mb-3">
                    <li class="nav-item"><a class="nav-link" href="#">Estadísticas</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Configuraciones</a></li>
                </ul>
                <hr />
                <div class="text-muted">© RoseDev S.A</div>
            </div>
        </div>

        <!-- Contenido principal -->
        <div class="col-md-9 py-3">
            <h3>Bienvenido al Panel de Administración</h3>
            <p>Selecciona una opción del menú lateral para comenzar.</p>
        </div>
    </div>
</div>