@model IEnumerable<ProjectEcommerce.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Dashboard</h1>

<p>
    <a asp-action="Create">+Crear nuevo producto</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor( model => model.ImageUrl )
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stock)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <img src="@item.ImageUrl" alt="@item.Name" width="70" height="70" class="img-thumbnail" onerror="this.onerror=null; this.src='/images/no-image.png';" />
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td class="action-buttons">
                <div class="btn-group" role="group">
                    <form asp-action="ReduceStock" asp-route-id="@item.Id" method="post" style="display: flex;">
                        <input type="number" name="quantityToRemove" min="1" max="@item.Stock" value="@item.Stock" class="form-control form-control-sm me-2" style="width: 80px;" min="0" />
                            <button type="submit" class="btn btn-sm btn-danger text-white" onclick="return confirm('¿Actualizar stock del producto?')"><i class="bi bi-trash"></i></button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm" title="Editar">
                        <i class="fas fa-edit"></i> Editar
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Detalles">
                        <i class="fas fa-info-circle"></i> Detalles</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
